{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/usre/.config/fastfetch/bleh.png",
    "width": 24,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "magenta",
      "title": "bright_magenta"
    },
    "key": {
      "width": 0
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS          "
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel      "
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime      "
    },
    {
      "type": "packages",
      "key": "󰏖 Packages    "
    },
    "break",
    {
      "type": "wm",
      "key": "󰨇 WM          "
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal    "
    },
    {
      "type": "shell",
      "key": "󰞷 Shell       "
    },
    "break",
    {
      "type": "cpu",
      "key": "󰍛 CPU         ",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU         ",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory      "
    },
    "break",
    "colors"
  ]
}
